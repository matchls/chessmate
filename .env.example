# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais préfixer une clé secrète par NEXT_PUBLIC_ : elle serait exposée au navigateur.

# Coach IA (route serveur /api/coach uniquement)
# Fournisseur : groq (par défaut) ou mistral
COACH_PROVIDER=
# Modèle : vide = modèle par défaut du fournisseur (groq : openai/gpt-oss-120b)
COACH_MODEL=
GROQ_API_KEY=
# Mistral : payant depuis octobre 2026, inutile en développement
MISTRAL_API_KEY=

# Base PostgreSQL Neon. En local : adresse d'une branche Neon de développement (jamais la
# production). Sur Vercel : remplie par l'intégration Neon (une branche par aperçu).
DATABASE_URL=

# Base « fantôme » (vide, jetable) utilisée par Prisma pour comparer migrations et schéma.
# Optionnelle en local (pnpm db:migrate en crée une temporaire) ; la CI la remplit avec un
# PostgreSQL temporaire.
SHADOW_DATABASE_URL=
