# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais préfixer une clé secrète par NEXT_PUBLIC_ : elle serait exposée au navigateur.

# Coach IA (route serveur /api/coach uniquement)
# Fournisseur : groq (par défaut) ou mistral
COACH_PROVIDER=
# Modèle : vide = modèle par défaut du fournisseur (groq : openai/gpt-oss-20b)
COACH_MODEL=
GROQ_API_KEY=
# Mistral : payant depuis octobre 2026, inutile en développement
MISTRAL_API_KEY=

# Base PostgreSQL Neon (étape BDD)
DATABASE_URL=
